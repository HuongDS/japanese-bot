# ==========================================
# CẤU HÌNH BOT DISCORD LUYỆN KAIWA TIẾNG NHẬT
# ==========================================

# 1. Token bot Discord (Lấy từ https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=MTEyMzQ1Njc4OTA...

# 2. ID tài khoản Discord của bạn (Bật Developer Mode trên Discord -> chuột phải vào tên bạn -> Copy User ID)
# Bot sẽ chỉ trò chuyện và nhận lệnh từ bạn để bảo mật
DISCORD_ALLOWED_USER_ID=123456789012345678

# 3. Kênh Discord muốn bot gửi tin nhắn hàng ngày (Tùy chọn)
# Nếu để trống, bot sẽ nhắn tin trực tiếp (DM) riêng cho bạn mỗi ngày
DISCORD_CHANNEL_ID=

# 4. API Key OpenAI để bot suy luận và hội thoại
OPENAI_API_KEY=sk-proj-...

# 5. Model GPT sử dụng (Khuyên dùng: gpt-4o để giải thích ngữ pháp hay nhất, hoặc gpt-4o-mini để siêu nhanh & tiết kiệm)
OPENAI_MODEL=gpt-4o

# 6. Giờ nhắn tin hỏi thăm và bắt đầu Kaiwa mỗi ngày (Múi giờ Việt Nam UTC+7)
# Mặc định là 08:30 sáng
DAILY_CHECKIN_HOUR=8
DAILY_CHECKIN_MINUTE=30

# 7. Trình độ tiếng Nhật khởi đầu (N5, N4, N4-N3, N3, N2, N1)
JAPANESE_LEVEL=N4-N3

# 8. Tên người bạn Nhật Bản
JAPANESE_BOT_NAME=Yuki (ユキ)

# 9. Cấu hình Giọng nói (Voice Note / TTS Kaiwa)
VOICE_ENABLED=true
JAPANESE_VOICE=nanami
